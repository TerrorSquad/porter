{
  "config": {
    "default": true,
    "MD013": false,
    "MD033": false,
    "MD041": false,
    "MD060": false,
    "MD001": false,
  },
  // Globs resolve relative to the working directory, and markdownlint-cli2 is
  // invoked from nodejs/ -- hence the ../ prefix to reach the repo root. See
  // nodejs/package.json and forge.toml.
  "globs": [
    "../**/*.md",
    "!**/node_modules/**",
    "!**/vendor/**",
    "!../flutter/build/**",
    "!../flutter/.dart_tool/**",
    "!../flutter/macos/Flutter/ephemeral/**",
    "!../flutter/third_party/**",
    "!**/target/**",
  ],
}
