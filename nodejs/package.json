{
  "name": "utils",
  "version": "1.0.0",
  "description": "Collection of JS/TS utilities",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "porter": "tsx src/porter.ts",
    "build:bundle": "rollup -c",
    "build": "pnpm run build:bundle && chmod +x dist/porter.mjs && cp dist/porter.mjs ~/.local/bin/porter",
    "build:external": "EXTERNAL_DEPS=qrcode-terminal pnpm run build:bundle && chmod +x dist/porter.mjs",
    "test": "tsx src/lib/chunker.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.30.1",
  "dependencies": {
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^20.11.24",
    "@types/qrcode-terminal": "^0.12.2",
    "rollup": "^4.59.0",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  }
}
