# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Matches Prettier's tabWidth (prettier.config.mjs)
[*.{js,jsx,ts,tsx,mjs,cjs,json,md,yml,yaml}]
indent_size = 2

# rustfmt / dart format own their own formatting; indent_size here is a
# fallback for editors that don't run the formatter on save.
[*.rs]
indent_size = 4

[*.dart]
indent_size = 2

[Dockerfile*]
trim_trailing_whitespace = true

# Ignore compiled/binary/vendored content
[{node_modules,dist,build,target,vendor}/**]
charset = binary
insert_final_newline = false
trim_trailing_whitespace = false
