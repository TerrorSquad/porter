{
  "format_on_save": "on",
  "formatter": "language_server",
  "languages": {
    "Dart": { "language_servers": ["dart"] },
    "TypeScript": {
      "formatter": { "language_server": { "name": "eslint" } }
    },
    "JavaScript": {
      "formatter": { "language_server": { "name": "eslint" } }
    },
    "Rust": { "language_servers": ["rust-analyzer"] }
  }
}
